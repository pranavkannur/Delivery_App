generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User roles in our system
enum Role {
  CUSTOMER
  DRIVER
  ADMIN
  PARTNER
}

// Driver vehicle types
enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
}

// Delivery order status
enum OrderStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  DELIVERED
  CANCELLED
}

// User model for customers, drivers, and admins
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CUSTOMER)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders Order[]  @relation("CustomerOrders")
  driver Driver?
  store  Store?
}

// Store profile for PARTNER users
model Store {
  id               String     @id @default(uuid())
  partnerId        String     @unique
  partner          User       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name             String
  category         String     @default("Bakery & Pastries")
  address          String?
  latitude         Float?
  longitude        Float?
  isLocationLocked Boolean    @default(false)
  pendingChange    Json?      // Holds { requestedAddress, requestedLat, requestedLng, reason, status: "PENDING" }
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  menuItems        MenuItem[]
}

// Menu items belonging to a store
model MenuItem {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Driver details (only created for users who are drivers)
model Driver {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType  VehicleType
  licensePlate String?
  isAvailable  Boolean     @default(true)
  latitude     Float?
  longitude    Float?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  deliveries   Order[]     @relation("DriverDeliveries")
}

// Order model for deliveries
model Order {
  id              String        @id @default(uuid())
  customerId      String
  customer        User          @relation("CustomerOrders", fields: [customerId], references: [id])
  driverId        String?
  driver          Driver?       @relation("DriverDeliveries", fields: [driverId], references: [id])
  status          OrderStatus   @default(PENDING)
  pickupAddress   String
  deliveryAddress String
  pickupLat       Float
  pickupLng       Float
  deliveryLat     Float
  deliveryLng     Float
  totalAmount     Float
  items           Json          
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deliveryOtp     String? 
  trackingLogs    TrackingLog[]
}

// History logs of driver locations for an active order
model TrackingLog {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())
}